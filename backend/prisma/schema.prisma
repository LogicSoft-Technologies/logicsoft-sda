// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Chat sessions ─────────────────────────────────────────────────────────────
model ChatSession {
  id            String        @id @default(cuid())
  sessionId     String        @unique
  status        SessionStatus @default(active)
  transferredTo String?
  pageUrl       String?
  userAgent     String?
  ip            String?
  messages      ChatMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("chat_sessions")
}

enum SessionStatus {
  active
  transferred_whatsapp
  closed
}

// ── Chat messages ─────────────────────────────────────────────────────────────
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role      MessageRole
  content   String      @db.VarChar(4000)
  createdAt DateTime    @default(now())

  @@map("chat_messages")
}

enum MessageRole {
  user
  assistant
}

// ── Staff ─────────────────────────────────────────────────────────────────────
model Staff {
  id                String   @id @default(cuid())
  name              String
  role              String
  whatsappNumber    String
  whatsappGreeting  String   @default("Hi! I'd like to discuss a project with Logicsoft Technologies.")
  avatarInitials    String   @db.VarChar(2)
  avatarColor       String   @default("#1f6fb2")
  isOnline          Boolean  @default(true)
  workingHoursStart Int      @default(8)
  workingHoursEnd   Int      @default(18)
  showInWidget      Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([showInWidget, order])
  @@map("staff")
}

// ── Contact submissions ───────────────────────────────────────────────────────
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  country   String?
  service   String?
  budget    String?
  message   String
  hasVoice  Boolean  @default(false)
  fileCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id                 String           @id @default(cuid())
  email              String           @unique
  firstName          String?
  status             SubscriberStatus @default(PENDING)
  source             String?          @db.VarChar(100)
  sourcePage         String?          @db.VarChar(500)
  consentAt          DateTime?
  confirmedAt        DateTime?
  confirmationToken  String?          @unique
  confirmationSentAt DateTime?
  unsubscribeToken   String           @unique @default(cuid())
  unsubscribedAt     DateTime?
  brevoContactId     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@map("newsletter_subscribers")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, role])
  @@map("admin_users")
}

model Author {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  bio       String?    @db.Text
  avatar    String?
  jobTitle  String?
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("authors")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  posts     BlogPostTag[]
  createdAt DateTime     @default(now())

  @@map("tags")
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text
  content        String        @db.Text
  coverImage     String?
  coverImageAlt  String?
  status         PostStatus    @default(DRAFT)
  featured       Boolean       @default(false)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  seoTitle       String?
  seoDescription String?       @db.Text
  canonicalUrl   String?
  readingMinutes Int           @default(1)
  authorId       String
  author         Author        @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  tags           BlogPostTag[]
  newsletterEditions NewsletterEdition[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, publishedAt(sort: Desc)])
  @@index([featured, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

enum NewsletterEditionStatus {
  DRAFT
  READY
  SENT
  ARCHIVED
}

model NewsletterEdition {
  id              String                  @id @default(cuid())
  title           String
  subject         String
  previewText     String?                 @db.Text
  htmlContent     String                  @db.Text
  status          NewsletterEditionStatus @default(DRAFT)
  scheduledFor    DateTime?
  sentAt          DateTime?
  brevoCampaignId String?
  sourcePostId    String?
  sourcePost      BlogPost?               @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([sourcePostId])
  @@map("newsletter_editions")
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}